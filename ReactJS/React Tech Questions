import React, {useEffect, useState} from "react";
import "./style.css";

const App = (props) => {
 const [count, setCount] = useState(0);

 useEffect(()=>{
  console.log('Hello');
  setCount(1);
 },[props.visible]);

 return(
   <div>{count}</div>
 )
}

export default App;  //1
